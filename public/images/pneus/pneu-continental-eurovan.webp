<link rel="https://api.w.org/" href="https://carpluscwb.com.br/wp-json/" /><link rel="EditURI" type="application/rsd+xml" title="RSD" href="https://carpluscwb.com.br/xmlrpc.php?rsd" />
<!-- start Simple Custom CSS and JS -->
<script>
jQuery(window).on('elementor/frontend/init', function () {
  if (typeof elementorProFrontend !== 'undefined' && elementorProFrontend.modules.popup) {
    jQuery('a[href^="#elementor-popup-"]').on('click', function (e) {
      e.preventDefault();
      const popupID = jQuery(this).attr('href').replace('#elementor-popup-', '');
      elementorProFrontend.modules.popup.showPopup({ id: parseInt(popupID) });
    });
  } else {
    // Espera mais tempo se não carregou ainda
    setTimeout(function () {
      jQuery('a[href^="#elementor-popup-"]').on('click', function (e) {
        e.preventDefault();
        const popupID = jQuery(this).attr('href').replace('#elementor-popup-', '');
        elementorProFrontend.modules.popup.showPopup({ id: parseInt(popupID) });
      });
    }, 2000);
  }
});
Object</script>
<!-- end Simple Custom CSS and JS -->
