						<div class="elementor-element elementor-element-6fa647b elementor-widget elementor-widget-html" data-id="6fa647b" data-element_type="widget" data-e-type="widget" data-widget_type="html.default">
				<div class="elementor-widget-container">
					<!-- FILTRO DE VEÍCULOS - VERSÃO SIMPLIFICADA COM EVENTOS INLINE -->

<div style="padding: 30px; background: white; border-radius: 15px; font-family: 'Ubuntu', Arial, sans-serif;">
    
    <!-- Título -->
    <h3 style="margin: 0 0 10px 0; font-size: 24px; font-weight: bold; text-align: center; color: #000000;">
        🚗 Buscar por Veículo
    </h3>
    
    <!-- Descrição -->
    <p style="text-align: center; margin-bottom: 25px; color: #666; font-size: 16px;">
        Selecione a marca e modelo do seu veículo para encontrar pneus compatíveis
    </p>

    <!-- Filtros -->
    <div style="display: flex; flex-direction: column; gap: 20px;">
        
        <!-- Marca -->
        <div>
            <label style="display: block; margin-bottom: 8px; font-weight: bold; color: #333; font-size: 16px;">
                Marca do Veículo:
            </label>
            <select id="marca-veiculo-select" onchange="selecionarMarca()" style="width: 100%; padding: 12px 15px; border: 2px solid #ddd; border-radius: 8px; font-size: 16px; background: white; color: #333; cursor: pointer; transition: all 0.3s;" onfocus="this.style.borderColor='#2a5298'" onblur="this.style.borderColor='#ddd'">
                <option value="">Selecione a Marca</option>
                <option value="Audi">Audi</option>
                <option value="Aston Martin">Aston Martin</option>
                <option value="BMW">BMW</option>
                <option value="Cadillac">Cadillac</option>
                <option value="Chevrolet">Chevrolet</option>
                <option value="Dodge">Dodge</option>
                <option value="Ferrari">Ferrari</option>
                <option value="Ford">Ford</option>
                <option value="Jaguar">Jaguar</option>
                <option value="Jeep">Jeep</option>
                <option value="Lamborghini">Lamborghini</option>
                <option value="Lexus">Lexus</option>
                <option value="Maserati">Maserati</option>
                <option value="Mercedes">Mercedes</option>
                <option value="Ssangyong">Ssangyong</option>
                <option value="Volvo">Volvo</option>
            </select>
        </div>

        <!-- Modelo -->
        <div>
            <label style="display: block; margin-bottom: 8px; font-weight: bold; color: #333; font-size: 16px;">
                Modelo do Veículo:
            </label>
            <select id="modelo-veiculo-select" onchange="verificarBusca()" disabled style="width: 100%; padding: 12px 15px; border: 2px solid #ddd; border-radius: 8px; font-size: 16px; background: #f5f5f5; color: #999; cursor: not-allowed; transition: all 0.3s;">
                <option value="">Primeiro selecione a marca</option>
            </select>
        </div>

    </div>

    <!-- Botões -->
    <div style="display: flex; gap: 15px; margin-top: 30px;">
        <button onclick="limparFiltro()" style="flex: 1; padding: 12px 20px; background: #6c757d; color: white; border: none; border-radius: 8px; font-size: 16px; cursor: pointer; transition: all 0.3s;" onmouseover="this.style.background='#5a6268'" onmouseout="this.style.background='#6c757d'">
            🗑️ Limpar
        </button>
        <button id="buscar-veiculo-btn" onclick="buscarVeiculos()" disabled style="flex: 2; padding: 12px 20px; background: #ccc; color: #666; border: none; border-radius: 8px; font-size: 16px; cursor: not-allowed; transition: all 0.3s;">
            🔍 Buscar Pneus
        </button>
    </div>

</div>

<script>
// DADOS DOS VEÍCULOS
const veiculosData = {
    "Audi": ["A4", "A5", "A6", "Q3", "RS Q3", "S4", "S5", "S6", "TT", "TT RS"],
    "Aston Martin": ["Vanquish-coupe", "Vanquish-Volante"],
    "BMW": ["M5", "M6", "Serie 3", "Serie 4", "Serie 5", "Serie 6", "Serie 7", "X3", "X4", "Z4", "Z8"],
    "Cadillac": ["CTS-V"],
    "Chevrolet": ["Blazer", "S-10", "S10"],
    "Dodge": ["Nitro"],
    "Ferrari": ["F12Berlinetta", "SF90 Stradale"],
    "Ford": ["Edge", "Ranger"],
    "Jaguar": ["F-TYPE", "XF"],
    "Jeep": ["Cherokee", "Grand Cherokee"],
    "Lamborghini": ["Aventador"],
    "Lexus": ["IS", "IS300", "IS350C"],
    "Maserati": ["Quattroporte"],
    "Mercedes": ["Classe C", "Classe C 63AMG", "Classe CLC", "Classe E", "Classe SL", "CLK", "CLS", "S63 AMG", "S63 L AMG", "S65 AMG", "S65 LAMG", "SLK"],
    "Ssangyong": ["Musso Sports", "Rexton"],
    "Volvo": ["S60", "S80", "S90", "V70", "XC40"]
};

// Função quando seleciona marca
function selecionarMarca() {
    const marcaSelect = document.getElementById('marca-veiculo-select');
    const modeloSelect = document.getElementById('modelo-veiculo-select');
    const buscarBtn = document.getElementById('buscar-veiculo-btn');
    
    const marcaSelecionada = marcaSelect.value;
    console.log('Marca selecionada:', marcaSelecionada);
    
    // Limpar modelos
    modeloSelect.innerHTML = '<option value="">Selecione o Modelo</option>';
    
    // Desabilitar busca
    buscarBtn.disabled = true;
    buscarBtn.style.background = '#ccc';
    buscarBtn.style.color = '#666';
    buscarBtn.style.cursor = 'not-allowed';
    
    if (marcaSelecionada === "") {
        // Sem marca selecionada
        modeloSelect.disabled = true;
        modeloSelect.style.background = '#f5f5f5';
        modeloSelect.style.color = '#999';
        modeloSelect.style.cursor = 'not-allowed';
    } else {
        // Marca selecionada - habilitar modelos
        modeloSelect.disabled = false;
        modeloSelect.style.background = 'white';
        modeloSelect.style.color = '#333';
        modeloSelect.style.cursor = 'pointer';
        
        // Adicionar modelos da marca
        const modelos = veiculosData[marcaSelecionada];
        console.log('Modelos disponíveis:', modelos);
        
        modelos.forEach(function(modelo) {
            const option = document.createElement('option');
            option.value = modelo;
            option.textContent = modelo;
            modeloSelect.appendChild(option);
        });
    }
}

// Função quando seleciona modelo
function verificarBusca() {
    const modeloSelect = document.getElementById('modelo-veiculo-select');
    const buscarBtn = document.getElementById('buscar-veiculo-btn');
    
    console.log('Modelo selecionado:', modeloSelect.value);
    
    if (modeloSelect.value !== "") {
        buscarBtn.disabled = false;
        buscarBtn.style.background = 'linear-gradient(135deg, #ff6b35 0%, #e55a2b 100%)';
        buscarBtn.style.color = 'white';
        buscarBtn.style.cursor = 'pointer';
    } else {
        buscarBtn.disabled = true;
        buscarBtn.style.background = '#ccc';
        buscarBtn.style.color = '#666';
        buscarBtn.style.cursor = 'not-allowed';
    }
}

// Função de busca
function buscarVeiculos() {
    const marcaSelect = document.getElementById('marca-veiculo-select');
    const modeloSelect = document.getElementById('modelo-veiculo-select');
    const buscarBtn = document.getElementById('buscar-veiculo-btn');
    
    const marca = marcaSelect.value;
    const modelo = modeloSelect.value;
    
    console.log('Buscando por:', marca, modelo);
    
    if (marca && modelo) {
        buscarBtn.innerHTML = '🔄 Buscando...';
        buscarBtn.disabled = true;
        
        // Construir termo de busca
        const termoBusca = marca + ' ' + modelo;
        const urlBusca = 'https://carpluscwb.com.br/?s=' + 
                       encodeURIComponent(termoBusca) + 
                       '&post_type=product';
        
        console.log('URL de busca:', urlBusca);
        
        setTimeout(function() {
            window.location.href = urlBusca;
        }, 800);
    } else {
        alert('Selecione marca e modelo!');
    }
}

// Função limpar
function limparFiltro() {
    const marcaSelect = document.getElementById('marca-veiculo-select');
    const modeloSelect = document.getElementById('modelo-veiculo-select');
    const buscarBtn = document.getElementById('buscar-veiculo-btn');
    
    console.log('Limpando filtro...');
    
    marcaSelect.value = "";
    modeloSelect.innerHTML = '<option value="">Primeiro selecione a marca</option>';
    modeloSelect.disabled = true;
    modeloSelect.style.background = '#f5f5f5';
    modeloSelect.style.color = '#999';
    modeloSelect.style.cursor = 'not-allowed';
    
    buscarBtn.disabled = true;
    buscarBtn.style.background = '#ccc';
    buscarBtn.style.color = '#666';
    buscarBtn.style.cursor = 'not-allowed';
    buscarBtn.innerHTML = '🔍 Buscar Pneus';
}
</script>

<style>
/* Responsividade para o filtro de veículos */
@media (max-width: 768px) {
    div[style*="padding: 30px"] {
        padding: 20px !important;
    }
    
    div[style*="padding: 30px"] h3 {
        font-size: 20px !important;
    }
    
    div[style*="padding: 30px"] select {
        font-size: 14px !important;
        padding: 10px 12px !important;
    }
    
    div[style*="padding: 30px"] button {
        font-size: 14px !important;
        padding: 10px 15px !important;
    }
    
    div[style*="display: flex; gap: 15px"] {
        flex-direction: column !important;
        gap: 12px !important;
    }
}
</style>				</div>
