{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "sitemap": "tsx scripts/generate-sitemap.ts",
    "redirects": "tsx scripts/generate-redirects.ts",
    "prebuild": "tsx scripts/generate-sitemap.ts && tsx scripts/generate-redirects.ts",
    "build": "vite build",
    "build:spa": "vite build",
    "generate:static:pilot": "node scripts/run-ts.mjs scripts/generate-static-pages.ts",
    "build:static:pilot": "npm run build:spa && npm run generate:static:pilot",
    "validate:static:pilot": "node scripts/run-ts.mjs scripts/validate-static-pilot.ts",
    "test:static:determinism": "node scripts/run-ts.mjs scripts/test-static-determinism.ts",
    "test:static:pilot": "npm run build:static:pilot && npm run validate:static:pilot && npm run test:static:determinism",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.14.2",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "puppeteer": "^25.3.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
